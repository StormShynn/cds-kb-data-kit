{
  "name": "cds-kb-mcp",
  "version": "1.5.0",
  "description": "Dataless MCP server for the SAP CDS knowledge base — search, compose, generate, and validate CDS view DDL. In this harness, prefers sibling docs/product/cds_kb_data; otherwise S3 when configured, else GitHub remote. Explicit --data/--remote always win over sibling/default.",
  "type": "module",
  "bin": {
    "cds-kb-mcp": "dist/cds-kb-mcp.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node src/server.mjs",
    "start:local": "node src/server.mjs --data ../cds_kb_data",
    "start:remote": "node src/server.mjs --remote https://raw.githubusercontent.com/StormShynn/cds-kb-data/main",
    "test": "node test_tools.mjs ../cds_kb_data"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "sap",
    "s4hana",
    "cds",
    "knowledge-base",
    "ai-agent",
    "claude"
  ],
  "dependencies": {
    "@abaplint/core": "^2.120.21",
    "@aws-sdk/client-s3": "^3.787.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "jose": "^6.0.10",
    "minisearch": "^7.2.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
